# --- new file: /etc/pam.d/omarchy-lock-usb ---
#%PAM-1.0
# Passwordless unlock via pam_usb hardware key (local customization).
# Uses pam_exec + pamusb-check instead of pam_usb.so directly: the module's
# UDisks device check hangs inside quickshell's PAM context (StartServiceByName
# timeout), while the standalone checker succeeds from a fresh process.
# Password/fingerprint remain as fallback.
auth       sufficient              pam_exec.so quiet /usr/bin/pamusb-check --quiet --service=omarchy-lock-usb denial
account    include                 system-local-login
