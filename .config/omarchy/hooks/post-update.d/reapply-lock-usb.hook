#!/bin/bash
set -e

PATCH="/home/denial/.config/omarchy/lock-usb.patch"
SERVICE="/usr/share/omarchy/shell/plugins/lock/Service.qml"

if [[ ! -f /etc/pam.d/omarchy-lock-usb ]]; then
  sudo tee /etc/pam.d/omarchy-lock-usb >/dev/null <<'PAM_EOF'
#%PAM-1.0
auth       sufficient              pam_exec.so quiet /usr/bin/pamusb-check --quiet --service=omarchy-lock-usb denial
account    include                 system-local-login
PAM_EOF
  sudo chmod 644 /etc/pam.d/omarchy-lock-usb
fi

if [[ -f "$PATCH" ]] && ! grep -q "usbKeyPresent" "$SERVICE" 2>/dev/null; then
  if sed '/^# --- new file/,$d' "$PATCH" | sudo patch -p3 -d / --forward -r -; then
    echo "Reapplied pamusb lock screen patch."
    omarchy-restart-shell || true
  else
    echo "Failed to reapply pamusb lock screen patch." >&2
  fi
fi
