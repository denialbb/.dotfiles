#!/bin/bash
set -e

# 1. Mask GNOME Keyring daemon user systemd units
systemctl --user mask gnome-keyring-daemon.service gnome-keyring-daemon.socket 2>/dev/null || true

# 2. Terminate any gnome-keyring-daemon instance handling secrets
pkill -f "gnome-keyring-daemon.*secrets" 2>/dev/null || true

# 3. Disable GNOME Keyring Secret Service autostart
mkdir -p "$HOME/.config/autostart"
cat <<'DESKTOP_EOF' > "$HOME/.config/autostart/gnome-keyring-secrets.desktop"
[Desktop Entry]
Type=Application
Name=Secret Storage Service
Hidden=true
DESKTOP_EOF

# 4. Ensure D-Bus user service activates KeePassXC for org.freedesktop.secrets
mkdir -p "$HOME/.local/share/dbus-1/services"
cat <<'DBUS_EOF' > "$HOME/.local/share/dbus-1/services/org.freedesktop.secrets.service"
[D-BUS Service]
Name=org.freedesktop.secrets
Exec=/usr/bin/keepassxc
DBUS_EOF

# 5. Ensure KeePassXC has FdoSecrets enabled
if [[ -f "$HOME/.config/keepassxc/keepassxc.ini" ]]; then
  if grep -q "\[FdoSecrets\]" "$HOME/.config/keepassxc/keepassxc.ini"; then
    sed -i '/^\[FdoSecrets\]/,/^\[/ s/^Enabled=false/Enabled=true/' "$HOME/.config/keepassxc/keepassxc.ini"
  else
    cat <<'INI_EOF' >> "$HOME/.config/keepassxc/keepassxc.ini"

[FdoSecrets]
ConfirmAccessItem=false
ConfirmDeleteItem=false
Enabled=true
ShowNotification=false
INI_EOF
  fi
fi

# 6. If KeePassXC is not running, ensure it is launched
if ! pgrep -x keepassxc >/dev/null 2>&1; then
  if command -v hyprctl >/dev/null 2>&1 && [[ -n $HYPRLAND_INSTANCE_SIGNATURE ]]; then
    hyprctl dispatch 'hl.dsp.exec_cmd("keepassxc")' >/dev/null 2>&1 || true
  fi
fi
