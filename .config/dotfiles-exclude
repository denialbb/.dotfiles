.ssh/*
!.ssh/config
.gnupg/
.pki/
.aws/
*.key
*credentials*
*secret*
!.config/omarchy/hooks/**
.gemini/google_accounts.json
.gemini/oauth_creds.json
.bash_history
.zsh_history
.python_history
.psql_history
.mysql_history

