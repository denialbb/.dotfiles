# Tracked copy of $HOME/.dotfiles/info/exclude (which is local-only and never
# pushed). Fresh clones: restore.sh copies this file there automatically.
# Manual: cp ~/.config/dotfiles-exclude ~/.dotfiles/info/exclude
.config/telegram-notify.conf
.config/agent-notify.conf
*-token*
*.pem
.config/nvim/

# --- data dirs: never dotfiles ---
Documents/
Downloads/
Music/
Pictures/
Videos/
Media/
Articles/
Projects/
Work/
mnt/

