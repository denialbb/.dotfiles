# ==============================================================================
# Sioyek Preferences - Synced with Omarchy Theme: matrix
# ==============================================================================

# Font sizes (compact & reduced, especially the bottom status bar)
font_size                   13
status_bar_font_size        11

# Startup commands: automatically enable custom color mode (themed dark mode)
startup_commands            toggle_custom_color

# Document text & background (Custom Color Mode - F8 or i)
custom_background_color     0.031 0.047 0.035
custom_text_color           0.545 0.788 0.549

# Application window & dark mode background
background_color            0.008 0.012 0.008
dark_mode_background_color  0.031 0.047 0.035
dark_mode_contrast          0.85

# Bottom Status bar
status_bar_color            0.020 0.027 0.020
status_bar_text_color       0.659 0.831 0.663

# Highlights & UI Accents
text_highlight_color        0.235 0.749 0.361
search_highlight_color      0.722 0.729 0.282
link_highlight_color        0.294 0.710 0.416
synctex_highlight_color     0.353 0.478 0.345
visual_mark_color           0.235 0.749 0.361 0.25
page_separator_color        0.227 0.408 0.251

# UI Usability defaults
wheel_zoom_on_cursor        1
should_draw_unrendered_pages 0
rerender_overview           1
