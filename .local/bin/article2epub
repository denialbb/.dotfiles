"""
article2epub - Convert web articles, blog posts, and arXiv papers into clean, e-ink ready EPUB/KEPUB files.
Deposits output files into ~/Articles/Inbox by default for easy pulling from KOReader / WebDAV / OPDS.
Includes offline e-ink grayscale image embedding, LaTeX/MathML rendering, and inbox archiving.
"""

import sys
import os
import re
import argparse
import datetime
import subprocess
import html
import io
import time
import shutil
from pathlib import Path
from urllib.parse import urlparse, urljoin
import base64

import requests
import trafilatura
from readability import Document
from bs4 import BeautifulSoup
import ebooklib
from ebooklib import epub
from PIL import Image
import latex2mathml.converter
import warnings
from bs4 import XMLParsedAsHTMLWarning
warnings.filterwarnings("ignore", category=XMLParsedAsHTMLWarning)

DEFAULT_INBOX_DIR = Path(os.environ.get("ARTICLES_INBOX_DIR", Path.home() / "Articles" / "Inbox"))
DEFAULT_ARCHIVE_DIR = Path(os.environ.get("ARTICLES_ARCHIVE_DIR", Path.home() / "Articles" / "Archive"))

