"""
ai-daily-digest - Automated multi-chapter e-ink digest generator for AI feeds.
Reads feeds from ~/.config/nom/config.yml, fetches recent articles, and bundles them
into a clean, multi-chapter KEPUB/EPUB in ~/Articles/Inbox.
"""

import os
import sys
import re
import html
import time
import argparse
import datetime
import subprocess
import warnings
from pathlib import Path
from urllib.parse import urlparse
