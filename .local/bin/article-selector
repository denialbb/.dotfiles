#!/usr/bin/env bash
# article-selector: Interactive article actions popup (80 cols, single-key input, no emojis)
set -euo pipefail

URL="${1:-}"
if [ -z "$URL" ]; then
    echo "Usage: article-selector <URL>"
    exit 1
fi

SHORT_URL="$URL"
if [ ${#SHORT_URL} -gt 65 ]; then
    SHORT_URL="${SHORT_URL:0:62}..."
fi

# Print clear menu without emojis
echo "Article Action:"
echo "  $SHORT_URL"
echo ""
echo "  [1] Read in Glow"
echo "  [2] Send EPUB to OPDS / Inbox"
echo "  [3] Open in Browser"
echo "  [4] Copy URL to Clipboard"
echo "  [q] Cancel"
echo ""

# Read a single key immediately without waiting for Enter
CHOICE=""
read -n 1 -r -s -p "Select option [1-4, q]: " CHOICE || true
echo ""

case "$CHOICE" in
    1)
        TEMP_MD=$(mktemp --suffix=.md)
        trap 'rm -f "$TEMP_MD"' EXIT

        FETCH_CMD=("$HOME/.local/bin/article-fetch" "$URL" "$TEMP_MD")
        if command -v gum >/dev/null 2>&1; then
            gum spin --spinner dot --title "Downloading & formatting article for Glow..." -- "${FETCH_CMD[@]}"
        else
            echo "Downloading article..."
            "${FETCH_CMD[@]}"
        fi

        if [ -s "$TEMP_MD" ]; then
            # Open glow with pager. Keeps terminal alive until user exits glow pager.
            glow -p "$TEMP_MD"
        else
            echo "Failed to extract article content."
            sleep 2
        fi
        ;;

    2)
        if [ ! -f "$HOME/.local/bin/article2epub" ]; then
            echo "Error: article2epub not found."
            sleep 2
            exit 1
        fi

        if command -v notify-send >/dev/null 2>&1; then
            notify-send -a "nom" "EPUB Generation" "Starting conversion for OPDS / Inbox..." -t 3000 || true
        fi

        nohup "$HOME/.local/bin/article2epub" "$URL" >/dev/null 2>&1 &
        disown || true
        echo "EPUB generation started in background."
        sleep 0.8
        ;;

    3)
        if command -v xdg-open >/dev/null 2>&1; then
            nohup xdg-open "$URL" >/dev/null 2>&1 &
            disown || true
        elif command -v open >/dev/null 2>&1; then
            nohup open "$URL" >/dev/null 2>&1 &
            disown || true
        fi
        ;;

    4)
        COPIED=0
        if command -v wl-copy >/dev/null 2>&1; then
            printf "%s" "$URL" | wl-copy
            COPIED=1
        elif command -v xclip >/dev/null 2>&1; then
            printf "%s" "$URL" | xclip -selection clipboard
            COPIED=1
        fi

        if [ "$COPIED" -eq 1 ]; then
            if command -v notify-send >/dev/null 2>&1; then
                notify-send -a "nom" "Clipboard" "Copied article URL" -t 3000 || true
            fi
            echo "Copied to clipboard."
            sleep 0.5
        fi
        ;;

    *)
        exit 0
        ;;
esac
