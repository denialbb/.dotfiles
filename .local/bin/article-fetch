#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.10"
# dependencies = [
#   "trafilatura>=1.12.0",
#   "readability-lxml>=0.8.1",
#   "beautifulsoup4>=4.12.0",
#   "requests>=2.31.0",
# ]
# ///
import sys
import os
import re
import urllib.request
import trafilatura
from readability import Document
from bs4 import BeautifulSoup

HEADERS = {
    "User-Agent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0.0.0 Safari/537.36",
    "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
}


def fetch_arxiv_html_or_abstract_md(arxiv_id: str) -> tuple[str, str, str]:
    """
    Check if arXiv paper has a full HTML version (arxiv.org/html/<id> or ar5iv).
    If available, converts full HTML paper into clean markdown for Glow.
    Otherwise falls back to structured metadata + abstract.
    """
    clean_id = re.sub(r"v[0-9]+$", "", arxiv_id)
    pdf_url = f"https://arxiv.org/pdf/{clean_id}.pdf"
    abs_url = f"https://arxiv.org/abs/{clean_id}"

    # 1. Fetch metadata (title, authors, summary) from export API as reliable baseline
    meta_title = f"arXiv:{clean_id}"
    meta_authors = "Unknown"
    meta_summary = ""
    meta_published = ""
    try:
        api_url = f"https://export.arxiv.org/api/query?id_list={clean_id}"
        req = urllib.request.Request(api_url, headers=HEADERS)
        with urllib.request.urlopen(req, timeout=8) as resp:
            xml_data = resp.read()
        soup_api = BeautifulSoup(xml_data, "xml")
        entry = soup_api.find("entry")
        if entry:
            if entry.title:
                meta_title = " ".join(entry.title.text.split())
            authors = [a.find("name").text for a in entry.find_all("author") if a.find("name")]
            if authors:
                meta_authors = ", ".join(authors)
            if entry.summary:
                meta_summary = entry.summary.text.strip()
            if entry.published:
                meta_published = entry.published.text[:10]
    except Exception:
        pass

    # 2. Check for full HTML paper: first arxiv.org/html/<id>, then ar5iv mirror
    full_html_content = ""
    html_endpoints = [
        f"https://arxiv.org/html/{clean_id}",
        f"https://ar5iv.labs.arxiv.org/html/{clean_id}",
    ]

    for candidate_url in html_endpoints:
        try:
            downloaded = trafilatura.fetch_url(candidate_url)
            if downloaded and ("ltx_document" in downloaded or "<article" in downloaded or "<body" in downloaded):
                # Verify it is not a 404/not yet available landing page
                if "No HTML version" not in downloaded and "HTML is not available" not in downloaded:
                    soup = BeautifulSoup(downloaded, "html.parser")
                    main_el = soup.find("article", class_=re.compile(r"ltx_document")) or soup.find("div", class_=re.compile(r"ltx_document"))
                    target_html = str(main_el) if main_el else downloaded

                    extracted_md = trafilatura.extract(
                        target_html,
                        output_format="markdown",
                        include_links=True,
                        include_images=True,
                        include_tables=True,
                        favor_recall=True,
                    )
                    if extracted_md and len(extracted_md.strip()) > 300:
                        full_html_content = extracted_md
                        break
        except Exception:
            continue

    # 3. Format header and body
    header = f"# {meta_title}\n\n"
    header += f"**Authors:** {meta_authors}  \n"
    if meta_published:
        header += f"**Published:** {meta_published}  \n"
    header += f"**Link:** [{abs_url}]({abs_url}) | [PDF]({pdf_url})\n\n---\n\n"

    if full_html_content:
        # Full HTML version available!
        header += "*(Rendering full arXiv HTML paper)*\n\n"
        full_md = header + full_html_content
    else:
        # Fallback to abstract
        header += f"### Abstract\n\n{meta_summary}\n\n*(Full HTML not available on arXiv; view PDF via link above)*\n"
        full_md = header

    return meta_title, meta_authors, full_md


def fetch_web_article_md(target_url: str) -> tuple[str, str, str]:
    downloaded = trafilatura.fetch_url(target_url)
    title = ""
    author = ""
    content_md = ""

    if downloaded:
        meta = trafilatura.extract_metadata(downloaded)
        if meta:
            title = meta.title or ""
            author = meta.author or ""

        content_md = trafilatura.extract(
            downloaded,
            output_format="markdown",
            include_links=True,
            include_images=True,
            include_tables=True,
            favor_recall=True,
        ) or ""

    if not content_md:
        try:
            import requests
            resp = requests.get(target_url, headers=HEADERS, timeout=15)
            doc = Document(resp.text)
            if not title:
                title = doc.short_title() or doc.title()
            soup = BeautifulSoup(doc.summary(), "html.parser")
            content_md = soup.get_text("\n\n").strip()
        except Exception:
            pass

    if not title:
        title = target_url.split("/")[-1].replace("-", " ").replace("_", " ") or "Article"

    header = f"# {title}\n\n"
    if author:
        header += f"**Author:** {author}  \n"
    header += f"**Source:** [{target_url}]({target_url})\n\n---\n\n"

    full_md = header + (content_md if content_md else "_Could not automatically extract article body._")
    return title, author, full_md


def main():
    if len(sys.argv) < 3:
        sys.exit(1)
    url = sys.argv[1]
    out_path = sys.argv[2]

    arxiv_match = re.search(r"arxiv\.org\/(?:abs|html|pdf)\/([0-9]{4}\.[0-9]{4,5})", url)
    raw_arxiv = re.match(r"^[0-9]{4}\.[0-9]{4,5}(v[0-9]+)?$", url)

    if arxiv_match:
        _, _, md = fetch_arxiv_html_or_abstract_md(arxiv_match.group(1))
    elif raw_arxiv:
        _, _, md = fetch_arxiv_html_or_abstract_md(url)
    else:
        _, _, md = fetch_web_article_md(url)

    with open(out_path, "w", encoding="utf-8") as f:
        f.write(md)


if __name__ == "__main__":
    main()
