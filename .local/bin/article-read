#!/usr/bin/env bash
# nom opener wrapper: opens interactive article action selector in a floating window / popup (80 col wide).
# Hierarchy:
# 1. TMUX: floating popup (80 cols) or vertical split fallback
# 2. Kitty: floating overlay window via remote control
# 3. Ghostty: floating popup window
# 4. Fallback: direct terminal execution

URL="${1:-}"
if [ -z "$URL" ]; then
    exit 0
fi

SELECTOR="$HOME/.local/bin/article-selector"

# 1. Inside TMUX: use 80-col floating popup
if [ -n "${TMUX:-}" ]; then
    # -E closes popup when command finishes
    # -w 80 sets exact 80 columns width
    # -h 65% sets comfortable height
    if tmux display-popup -E -w 80 -h 65% -T " Article Actions " "$SELECTOR" "$URL" 2>/dev/null; then
        exit 0
    fi
    # Fallback to vertical split if popup unsupported:
    if tmux split-window -h -l 80 "$SELECTOR $URL" 2>/dev/null; then
        exit 0
    fi
fi

# 2. Inside Kitty: launch overlay window
if [ -n "${KITTY_PID:-}" ] || [ -n "${KITTY_WINDOW_ID:-}" ]; then
    if kitty @ launch --type=overlay --title="Article Actions" "$SELECTOR" "$URL" 2>/dev/null; then
        exit 0
    fi
fi

# 3. Inside Ghostty: launch floating popup terminal
if [ -n "${GHOSTTY_RESOURCES_DIR:-}" ] || [ "${TERM:-}" = "xterm-ghostty" ]; then
    if command -v ghostty >/dev/null 2>&1; then
        ghostty --class=popup-terminal -e "$SELECTOR" "$URL" &
        exit 0
    fi
fi

# 4. Fallback: direct terminal execution
exec "$SELECTOR" "$URL"
