#!/usr/bin/env bash
# nom opener wrapper: opens interactive article action selector in a floating window / popup (80 cols, 80% height).
# When takeover is false, nom does NOT exit its alt-screen, so the floating popup/overlay
# appears directly on top of the visible nom TUI.

URL="${1:-}"
if [ -z "$URL" ]; then
    exit 0
fi

SELECTOR="$HOME/.local/bin/article-selector"

# 1. Inside TMUX: use floating popup directly over the active pane!
if [ -n "${TMUX:-}" ]; then
    # -E closes popup when command exits
    # -w 80 sets width to 80 columns
    # -h 80% sets height to 80%
    if tmux display-popup -E -w 80 -h 80% -T " Article Actions " "$SELECTOR" "$URL" 2>/dev/null; then
        exit 0
    fi
    # Fallback to vertical split if popup unsupported
    if tmux split-window -h -l 80 "$SELECTOR $URL" 2>/dev/null; then
        exit 0
    fi
fi

# 2. Inside Kitty: launch overlay window directly over the running nom window
if [ -n "${KITTY_PID:-}" ] || [ -n "${KITTY_WINDOW_ID:-}" ]; then
    if kitty @ launch --type=overlay --title="Article Actions" "$SELECTOR" "$URL" 2>/dev/null; then
        exit 0
    fi
fi

# 3. Inside Ghostty or graphical terminal: launch floating popup terminal
if [ -n "${GHOSTTY_RESOURCES_DIR:-}" ] || [ "${TERM:-}" = "xterm-ghostty" ]; then
    if command -v ghostty >/dev/null 2>&1; then
        ghostty --class=popup-terminal -e "$SELECTOR" "$URL" &
        exit 0
    fi
fi

# 4. Fallback: execute directly
exec "$SELECTOR" "$URL"
