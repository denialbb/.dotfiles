#!/usr/bin/env bash
# nom opener wrapper: opens interactive article action selector in a floating window / popup.
# Hierarchy:
# 1. Kitty: launch floating window overlay via kitty remote control
# 2. Ghostty: floating terminal popup or split
# 3. Tmux: tmux display-popup (or vertical split fallback)
# 4. Fallback: direct terminal execution

URL="$1"

if [ -z "$URL" ]; then
    exit 0
fi

SELECTOR="$HOME/.local/bin/article-selector"

# 1. Inside TMUX: use floating popup! (tmux display-popup -E ...)
if [ -n "${TMUX:-}" ]; then
    # -E closes popup automatically when command exits
    # -w 80% -h 75% gives a floating dialog in the center of the terminal
    tmux display-popup -E -w 85% -h 80% -T " Article Actions " "$SELECTOR" "$URL"
    exit 0
fi

# 2. Inside Kitty: use kitty overlay / floating window
if [ -n "${KITTY_PID:-}" ] || [ -n "${KITTY_WINDOW_ID:-}" ]; then
    # Try kitty remote control overlay window
    if kitty @ launch --type=overlay "$SELECTOR" "$URL" 2>/dev/null; then
        exit 0
    fi
fi

# 3. Inside Ghostty or generic Wayland/X11
if [ -n "${GHOSTTY_RESOURCES_DIR:-}" ]; then
    if command -v ghostty >/dev/null 2>&1; then
        ghostty --class=popup-terminal -e "$SELECTOR" "$URL" &
        exit 0
    fi
fi

# 4. Fallback: execute directly in current terminal
exec "$SELECTOR" "$URL"
